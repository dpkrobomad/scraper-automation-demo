{
  "name": "Daily price & stock alert",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 8 }] }
      },
      "id": "a1",
      "name": "Every day at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCRAPER_URL }}/run?max_pages=5",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-API-Key", "value": "={{ $env.SCRAPER_API_KEY }}" }] },
        "options": { "timeout": 300000 }
      },
      "id": "a2",
      "name": "Run scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.changes.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a3",
      "name": "Anything changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const run = $input.first().json;\nconst lines = run.changes.map(c => c.kind === 'price'\n  ? `• ${c.title}: £${c.old_value} → £${c.new_value}`\n  : `• ${c.title}: ${c.new_value === 'True' ? 'back in stock' : 'out of stock'}`);\nreturn [{ json: { text: `*${run.changes.length} changes* across ${run.scraped} items\\n` + lines.join('\\n') } }];"
      },
      "id": "a4",
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -80]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#price-alerts", "mode": "name" },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "a5",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [960, -80]
    }
  ],
  "connections": {
    "Every day at 8am": { "main": [[{ "node": "Run scraper", "type": "main", "index": 0 }]] },
    "Run scraper": { "main": [[{ "node": "Anything changed?", "type": "main", "index": 0 }]] },
    "Anything changed?": { "main": [[{ "node": "Format message", "type": "main", "index": 0 }], []] },
    "Format message": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
